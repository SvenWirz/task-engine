{
  "uid": "task-engine",
  "title": "Task-Engine",
  "tags": ["task-engine"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pending",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(taskengine_queue_depth{status=\"PENDING\"})" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "cyan" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(taskengine_queue_depth{status=\"RUNNING\"})" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dead",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(taskengine_queue_depth{status=\"DEAD\"})" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erfolgreich verarbeitet (gesamt)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(taskengine_processing_seconds_count{result=\"succeeded\"})" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Queue-Tiefe nach Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "none" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "taskengine_queue_depth", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Durchsatz: gestartete Tasks/s nach Typ",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (rate(taskengine_started_total[1m]))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Erfolg vs. Fehlschläge /s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(taskengine_processing_seconds_count{result=\"succeeded\"}[1m]))", "legendFormat": "succeeded" },
        { "refId": "B", "expr": "sum by (outcome) (rate(taskengine_failed_total[1m]))", "legendFormat": "failed: {{outcome}}" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Verarbeitungsdauer (Perzentile)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max by (quantile) (taskengine_processing_seconds)", "legendFormat": "p{{quantile}}" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Geclaimte Tasks /s",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(taskengine_claimed_total[1m])", "legendFormat": "claimed/s" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Timeouts /s nach Typ",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (rate(taskengine_timeout_total[1m]))", "legendFormat": "{{type}}" }
      ]
    }
  ]
}
