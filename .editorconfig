# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{xml,html}]
indent_size = 4

# Maven wrapper scripts are generated — leave them untouched.
[mvnw]
end_of_line = lf

[mvnw.cmd]
end_of_line = crlf
